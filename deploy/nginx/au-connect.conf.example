# Example nginx config for AU Connect on the life.au.edu server.
# Copy into the server's nginx config (or paste the `location` block into the
# existing life.au.edu server block), then `sudo nginx -t && sudo nginx -s reload`.
# TLS (443/certbot) is normally handled by the AU team's existing setup.

# ─────────────────────────────────────────────────────────────────────────
# Sub-path:  https://life.au.edu/connect
# Requires the app to be built with  basePath: "/connect"  in next.config.ts
# and  NEXT_PUBLIC_BASE_URL=https://life.au.edu/connect  (see DEPLOYMENT.md).
# ─────────────────────────────────────────────────────────────────────────
server {
    listen 80;
    server_name life.au.edu;

    # ... other super-app routes live in their own location blocks ...

    # Forward the origin root to Next so its / → /connect redirect also works
    # in production. Keep the original URI.
    location = / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location = /connect {
        proxy_pass         http://127.0.0.1:3000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /connect/ {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }
}
