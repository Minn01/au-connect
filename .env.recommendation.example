# Recommendation API environment (copy to .env.recommendation, fill in)
# Variable names match the service code (core/env.py in the reco repo),
# not older docs.

# MongoDB connection. The database is selected by MONGODB_DB below,
# so no database name is needed in the URL.
MONGODB_URL=mongodb://mongo:27017/?directConnection=true

# Must equal the database in the main app's DATABASE_URL.
# The main app uses au-connect (hyphen). Using au_connect (underscore)
# connects fine but sees an empty database: zero recommendations, zero errors.
MONGODB_DB=au-connect

# Shared secret the main app sends as x-internal-service-key.
# Must equal the main app's RECOMMENDATION_SERVICE_API_KEY.
INTERNAL_API_KEY=

# HuggingFace token, used when the embedding model needs downloading.
HF_TOKEN=

# CPU threading caps, keep the service polite on small shared hosts.
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
