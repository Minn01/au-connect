# ─────────────────────────────────────────────────────────────────────────
# Recommendation API — production environment (copy to .env.recommendation)
# The exact variables come from the RECOMMENDATION repo's own README.
# Below are the ones most likely needed; add/remove to match that repo.
# ─────────────────────────────────────────────────────────────────────────

# Port the FastAPI app listens on inside the container (matches the Dockerfile
# and the `expose: 8000` in docker-compose.prod.yml).
PORT=8000

# Shared secret the main app sends to authenticate. MUST equal the main app's
# RECOMMENDATION_SERVICE_API_KEY in .env.
RECOMMENDATION_SERVICE_API_KEY=

# Only if the service reads MongoDB directly (embeddings, user data).
DATABASE_URL=mongodb://mongo:27017/au-connect?directConnection=true
