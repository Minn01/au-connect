# Admin app environment (copy to .env.admin, fill in)
# Runtime variables only, matching the admin repo's lib/env.ts.
# The admin app's basePath is a BUILD-time setting in the admin repo
# (NEXT_PUBLIC_BASE_PATH=/connect-admin when building the image),
# it is intentionally not part of this runtime file.
# For local test stacks, use the localhost variants of the two URLs below.

NODE_ENV=production

# Same MongoDB the main app uses, keep the database name identical
# to the main app's DATABASE_URL (au-connect).
DATABASE_URL=mongodb://mongo:27017/au-connect?directConnection=true

# Canonical public URL of the admin app (OAuth redirects, invitations).
ADMIN_PUBLIC_URL=https://life.au.edu/connect-admin

# Where the admin UI links to the main application.
MAIN_APP_PATH=https://life.au.edu/connect

# Session signing secret for the admin session cookie.
JWT_SECRET=

# Microsoft / Entra auth, same app registration as the main app.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Azure Blob Storage, admin media uploads.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
