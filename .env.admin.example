# ─────────────────────────────────────────────────────────────────────────
# Admin app — production environment (copy to .env.admin, fill in)
# The exact variables come from the ADMIN repo's own README/.env.example.
# Below are the ones most likely needed; add/remove to match that repo.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Same MongoDB the main app uses (the container on the private network).
DATABASE_URL=mongodb://mongo:27017/au-connect?directConnection=true

# If the admin app shares AU Connect's login/JWT, use the SAME value as the
# main app's JWT_SECRET.
JWT_SECRET=

# If the admin app is a Next.js app served under /connect-admin, it needs the
# same basePath + build-arg treatment as the main app (see DEPLOYMENT.md).
NEXT_PUBLIC_BASE_URL=https://life.au.edu/connect-admin
