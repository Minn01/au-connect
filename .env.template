# ─────────────────────────────────────────────────────────────────────────
# AU Connect — production environment template
# Copy to .env, fill in the values, then run `make prod-up`.
# The filled-in .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# Public URL where the app is served. MUST be https in production.
#   • If served at a sub-path (life.au.edu/connect) use the full path here
#     AND set basePath in next.config.ts — see DEPLOYMENT.md.
#   • ⚠ This value is baked into the image at BUILD time, so it must ALSO be
#     set as the CI build-arg (GitHub Actions variable NEXT_PUBLIC_BASE_URL).
#     Setting it only here is not enough for the browser-side code.
NEXT_PUBLIC_BASE_URL=https://life.au.edu/connect

NODE_ENV=production

# ── Database ───────────────────────────────────────────────────────────────
# Points at the self-hosted MongoDB container from docker-compose.prod.yml.
# (To use MongoDB Atlas instead, paste an mongodb+srv://... string here.)
DATABASE_URL=mongodb://mongo:27017/au-connect?directConnection=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random value, e.g.  openssl rand -base64 32
JWT_SECRET=

# Base64-encoded 32-byte key used to encrypt message text stored in MongoDB.
# Generate once with: openssl rand -base64 32
# Keep this key stable and backed up; losing it makes encrypted messages unreadable.
MESSAGE_ENCRYPTION_KEY=

# ── OAuth providers ──────────────────────────────────────────────────────────
# Register these redirect URIs with each provider (replace the host with your
# real NEXT_PUBLIC_BASE_URL):
#   <NEXT_PUBLIC_BASE_URL>/api/connect/v1/auth/google/callback
#   <NEXT_PUBLIC_BASE_URL>/api/connect/v1/auth/linkedin/callback
#   <NEXT_PUBLIC_BASE_URL>/api/connect/v1/auth/azure-ad/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Azure Blob Storage (media uploads) ───────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# ── Email (Gmail SMTP, used for notifications) ────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Recommendation service (internal, called by the main app) ─────────────────
# Reachable on the private docker network by service name. Leave as-is unless
# you rename the service in docker-compose.prod.yml. The app requires this URL.
RECOMMENDATION_SERVICE_URL=http://recommendation:8000
# Must match RECOMMENDATION_SERVICE_API_KEY in .env.recommendation.
RECOMMENDATION_SERVICE_API_KEY=

# ── Images to deploy (Docker Hub) ─────────────────────────────────────────────
# The three images the AU Docker host pulls. Change the account/repo if yours
# differ. (docker compose auto-reads THIS .env for these ${...} substitutions.)
AU_CONNECT_IMAGE=tommyzizii/au-connect:latest
ADMIN_IMAGE=tommyzizii/au-connect-admin:latest
RECO_IMAGE=tommyzizii/au-connect-recommendation:latest
